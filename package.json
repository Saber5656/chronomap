{
  "name": "chronomap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm run typecheck:web && npm run mobile:typecheck",
    "typecheck:web": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:pins": "node scripts/check-action-pinning.mjs",
    "licenses:refresh": "node scripts/update-third-party-notices.mjs",
    "smoke:providers": "node scripts/smoke-providers.mjs",
    "validate:pwa": "node scripts/validate-pwa-build.mjs",
    "validate:pwa:preview": "node scripts/validate-pwa-preview.mjs",
    "validate:commons:off": "node scripts/validate-commons-build.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "validate:readme": "node scripts/validate-readme-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:security": "vitest run tests/security && playwright test security/e2e --project=mobile-chromium",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:commons": "playwright test --config=playwright.commons.config.ts",
    "e2e:ui": "playwright test --ui",
    "mobile:start": "npm run start --workspace @chronomap/mobile",
    "mobile:start:tunnel": "npm run start:tunnel --workspace @chronomap/mobile",
    "mobile:android": "npm run android --workspace @chronomap/mobile",
    "mobile:ios": "npm run ios --workspace @chronomap/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @chronomap/mobile",
    "mobile:doctor": "npm run doctor --workspace @chronomap/mobile",
    "mobile:export": "npm run export --workspace @chronomap/mobile",
    "mobile:verify": "npm run mobile:doctor && npm run mobile:typecheck && npm run mobile:export"
  },
  "dependencies": {
    "maplibre-gl": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "license-checker": "25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
